.*
!.github
!.gitignore

# beads: track only the jsonl exports, everything else under .beads is local tooling
!.beads
.beads/*
!.beads/*.jsonl
# .agents/ and .codex/ are local agent tooling, kept ignored by the .* rule above

# agent instruction files stay local and untracked
AGENTS.md
CLAUDE.md

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Project specific
*.zip

# Local dev helper (hardcoded ssh host/container) - stays local
/dev-deploy.sh

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Dashboard Vite source: node_modules stays local
src/dash/ui/node_modules/

# Dashboard build output: hashed bundles are rebuilt by package.sh / dev-deploy.sh build
src/dash/static/assets/
